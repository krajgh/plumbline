{
  "description": "The detective's record, written once no blocker stands: what is missing that the review did not cover.",
  "type": "object",
  "required": ["gaps"],
  "additionalProperties": false,
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "detail", "ac"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["missing_test", "edge_case", "uncovered_ac"]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "ac": {
            "description": "The acceptance criterion the gap concerns, or null.",
            "type": ["string", "null"],
            "pattern": "^AC-[0-9]+$"
          }
        }
      }
    }
  }
}
